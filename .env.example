# Browser-safe Supabase settings. Obtain these from Supabase Project Connect and
# add the real values only to .env.local / your deployment environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values belong in .env.local, never in browser code or Git.
# SUPABASE_SERVICE_ROLE_KEY=

# In Supabase Auth, add these deployment redirect URLs before inviting staff:
# http://localhost:3000/auth/callback
# https://your-production-domain/auth/callback
