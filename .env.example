# Browser-safe Supabase settings. Obtain these from Supabase Project Connect and
# add the real values only to .env.local / your deployment environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values belong in .env.local, never in browser code or Git.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only outbound SMTP transport for the Emails module.
# Configure these in the deployment's encrypted environment settings.
BETANOR_SMTP_HOST=
BETANOR_SMTP_PORT=587
BETANOR_SMTP_USER=
BETANOR_SMTP_PASSWORD=
BETANOR_SMTP_FROM=
BETANOR_SMTP_FROM_NAME=Betanor
# Set true for implicit TLS (usually port 465); port 587 uses STARTTLS.
BETANOR_SMTP_SECURE=false
# BETANOR_SMTP_REPLY_TO=

# In Supabase Auth, add these deployment redirect URLs before inviting staff:
# http://localhost:3000/auth/callback
# https://your-production-domain/auth/callback
